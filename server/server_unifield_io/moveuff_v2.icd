      <DO name="BatLo" type="SPS_Generic"/>
      <DO name="Beh" type="ENS_Beh"/>
      <DO name="Health" type="ENS_Health"/>
      <DO name="Vol" type="MV_Generic"/>
      <DO name="Amp" type="MV_Generic"/>
      <DO name="VolChgRte" type="MV_Generic"/>
