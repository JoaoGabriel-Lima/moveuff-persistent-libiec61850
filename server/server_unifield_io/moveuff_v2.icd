<?xml version="1.0" encoding="UTF-8"?>
<SCL xmlns="http://www.iec.ch/61850/2003/SCL">
  <Header id="MoveUFF" nameStructure="IEDName" />
  <IED name="MoveUFF_Geral">
    <Services>
      <GetDirectory /><GetDataObjectDefinition /><ReadWrite /><GetCBValues />
      <ConfLNs fixPrefix="true" fixLnInst="true" />
    </Services>
    <AccessPoint name="AP1">
      <Server>
        <Authentication />

        <LDevice inst="B1EBK">
          <LN0 lnClass="LLN0" lnType="LLN01" inst="">
            <DOI name="Mod" /> <DOI name="Beh" /> <DOI name="Health" /> <DOI name="NamPlt" /> <DOI name="Diag" /> <DOI name="LEDRs" />
            <DataSet name="BikeTelemetry" desc="MoveUFF bike telemetry">
              <FCDA ldInst="B1STG" lnClass="ZBAT" fc="MX" lnInst="1" doName="Vol" daName="mag.f" />
              <FCDA ldInst="B1STG" lnClass="ZBAT" fc="MX" lnInst="1" doName="Amp" daName="mag.f" />
              <FCDA ldInst="B1STG" lnClass="DBAT" fc="MX" lnInst="1" doName="SocPro" daName="mag.f" />
              <FCDA ldInst="B1HYD" lnClass="DSTK" fc="MX" lnInst="1" doName="InH2Pres" daName="mag.f" />
              <FCDA ldInst="B1HYD" lnClass="DSTK" fc="MX" lnInst="1" doName="OutDCA" daName="mag.f" />
              <FCDA ldInst="B1HYD" lnClass="DSTK" fc="MX" lnInst="1" doName="OutDCV" daName="mag.f" />
              <FCDA ldInst="B1EBK" lnClass="TLOC" fc="ST" lnInst="1" doName="GeoLoc" daName="latitude" />
              <FCDA ldInst="B1EBK" lnClass="TLOC" fc="ST" lnInst="1" doName="GeoLoc" daName="longitude" />
              <FCDA ldInst="B1EBK" lnClass="TLOC" fc="ST" lnInst="1" doName="NavFai" daName="stVal" />
              <FCDA ldInst="B1EBK" lnClass="TLOC" fc="ST" lnInst="1" doName="SatAvl" daName="stVal" />
              <FCDA ldInst="B1EBK" prefix="LANT" lnClass="XSWI" fc="ST" lnInst="1" doName="Pos" daName="stVal" />
              <FCDA ldInst="B1EBK" prefix="MOT" lnClass="XSWI" fc="ST" lnInst="1" doName="Pos" daName="stVal" />
              <FCDA ldInst="B1EBK" prefix="ALM" lnClass="XSWI" fc="ST" lnInst="1" doName="Pos" daName="stVal" />
              <FCDA ldInst="B1HYD" prefix="CEL" lnClass="XSWI" fc="ST" lnInst="1" doName="Pos" daName="stVal" />
              <FCDA ldInst="B1HYD" prefix="TNK" lnClass="XSWI" fc="ST" lnInst="1" doName="Pos" daName="stVal" />
              <FCDA ldInst="B1STG" lnClass="XSWI" fc="ST" lnInst="1" doName="Pos" daName="stVal" />
            </DataSet>
            <ReportControl name="BikeTelemetryRCB" desc="MoveUFF bike telemetry reports" confRev="1" datSet="BikeTelemetry" rptID="BikeTelemetry" buffered="false" intgPd="1000" bufTime="50">
              <TrgOps dchg="true" qchg="true" period="true" />
              <OptFields seqNum="true" timeStamp="true" dataSet="true" reasonCode="true" configRef="true" />
              <RptEnabled max="1" />
            </ReportControl>
          </LN0>
          <LN lnClass="DEEV" lnType="DEEV1_Typ" inst="1" prefix="">
            <DOI name="EVNam" /> <DOI name="NamPlt" /> <DOI name="ConnTypSel" /> <DOI name="Beh" /> <DOI name="Health" /> <DOI name="Soc" /> <DOI name="EVId" /> <DOI name="DptTm" /> <DOI name="VMax" /> <DOI name="AMax" /> <DOI name="AMin" /> <DOI name="EnAmnt" />
          </LN>
          <LN lnClass="ISAF" lnType="ISAF1_Typ" inst="1" prefix="">
            <DOI name="Alm" /> <DOI name="Beh" /> <DOI name="Health" />
          </LN>
          <LN lnClass="XSWI" lnType="XSWI1_Typ" inst="1" prefix="LANT">
            <DOI name="EEName" /> <DOI name="NamPlt" /> <DOI name="SwOpCap" /> <DOI name="Loc" /> <DOI name="LocKey" /> <DOI name="EEHealth" /> <DOI name="Blk" /> <DOI name="Beh" /> <DOI name="Health" /> <DOI name="LocSta" /> <DOI name="Pos" /> <DOI name="BlkOpn" /> <DOI name="BlkCls" /> <DOI name="Mod" /> <DOI name="BlkRef" />
          </LN>
          <LN lnClass="XSWI" lnType="XSWI1_Typ" inst="1" prefix="ALM">
            <DOI name="EEName" /> <DOI name="NamPlt" /> <DOI name="SwOpCap" /> <DOI name="Loc" /> <DOI name="LocKey" /> <DOI name="EEHealth" /> <DOI name="Blk" /> <DOI name="Beh" /> <DOI name="Health" /> <DOI name="LocSta" /> <DOI name="Pos" /> <DOI name="BlkOpn" /> <DOI name="BlkCls" /> <DOI name="Mod" /> <DOI name="BlkRef" />
          </LN>
          <LN lnClass="XSWI" lnType="XSWI1_Typ" inst="1" prefix="MOT">
            <DOI name="EEName" /> <DOI name="NamPlt" /> <DOI name="SwOpCap" /> <DOI name="Loc" /> <DOI name="LocKey" /> <DOI name="EEHealth" /> <DOI name="Blk" /> <DOI name="Beh" /> <DOI name="Health" /> <DOI name="LocSta" /> <DOI name="Pos" /> <DOI name="BlkOpn" /> <DOI name="BlkCls" /> <DOI name="Mod" /> <DOI name="BlkRef" />
          </LN>
          <LN lnClass="TMVM" lnType="TMVM1_Typ" inst="1" prefix="">
            <DOI name="EEHealth" /> <DOI name="Beh" /> <DOI name="Health" /> <DOI name="MvmRteSv" />
          </LN>
          <LN lnClass="ZMOT" lnType="ZMOT1_Typ" inst="1" prefix="">
            <DOI name="EEName" /> <DOI name="RotThmSt" /> <DOI name="PresAlm" /> <DOI name="EEHealth" /> <DOI name="MotSt" /> <DOI name="NamPlt" />
          </LN>
          <LN lnClass="MMXU" lnType="MMXU1_Typ" inst="1" prefix="">
            <DOI name="NamPlt" /> <DOI name="Beh" /> <DOI name="Health" /> <DOI name="TotW" />
          </LN>
          <LN lnClass="TLOC" lnType="TLOC1_Typ" inst="1" prefix="">
            <DOI name="DistTot" /> <DOI name="DistSess" /> <DOI name="NavFai" /> <DOI name="SatAvl" /> <DOI name="LocPrec" /> <DOI name="LocDist" /> <DOI name="AutDis" /> <DOI name="GeoLoc" />
          </LN>
        </LDevice>

        <LDevice inst="B1CTR">
          <LN0 lnClass="LLN0" lnType="LLN01" inst="">
            <DOI name="Mod" /> <DOI name="Beh" /> <DOI name="Health" /> <DOI name="NamPlt" /> <DOI name="Diag" /> <DOI name="LEDRs" />
          </LN0>
          <LN lnClass="LPHD" lnType="LPHD1_Typ" inst="1" prefix="">
            <DOI name="NamPlt" /> <DOI name="PhyNam" /> <DOI name="PhyHealth" /> <DOI name="OutOv" /> <DOI name="Proxy" /> <DOI name="OpTmh" /> <DOI name="Sim" />
          </LN>
          <LN lnClass="LGOS" lnType="LGOS1_Typ" inst="1" prefix="">
            <DOI name="Beh" /> <DOI name="Health" /> <DOI name="GoCBRef" /> <DOI name="St" /> <DOI name="NdsCom" /> <DOI name="SimSt" /> <DOI name="ConfRevNum" /> <DOI name="RxConfRevNum" /> <DOI name="LastStNum" />
          </LN>
          <LN lnClass="LTIM" lnType="LTIM1_Typ" inst="1" prefix="">
            <DOI name="Beh" /> <DOI name="Health" /> <DOI name="TmDT" />
          </LN>
          <LN lnClass="LTMS" lnType="LTMS1_Typ" inst="1" prefix="">
            <DOI name="TmSrc" /> <DOI name="TmSrcTyp" /> <DOI name="Beh" />
          </LN>
          <LN lnClass="LTRK" lnType="LTRK1_Typ" inst="1" prefix="">
            <DOI name="Beh" /> <DOI name="Health" /> <DOI name="GenTrk" /> <DOI name="UrcbTrk" /> <DOI name="BrcbTrk" /> <DOI name="GocbTrk" />
          </LN>
        </LDevice>

        <LDevice inst="B1HYD">
          <LN0 lnClass="LLN0" lnType="LLN01" inst="" />
          <LN lnClass="KTNK" lnType="KTNK1_Typ" inst="1" prefix="">
            <DOI name="NamPlt" /> <DOI name="EEHealth" /> <DOI name="OpTmh" /> <DOI name="Beh" /> <DOI name="Health" /> <DOI name="LevPct" /> <DOI name="Vlm" /> <DOI name="VlmCap" /> <DOI name="TnkTyp" />
          </LN>
          <LN lnClass="STMP" lnType="STMP1_Typ" inst="1" prefix="">
            <DOI name="Trip" /> <DOI name="RteTrip" /> <DOI name="Tmp" /> <DOI name="TmpRte" /> <DOI name="TripSet" /> <DOI name="RteTripSet" />
          </LN>
          <LN lnClass="KVLV" lnType="KVLV1_Typ" inst="1" prefix="">
            <DOI name="OpCnt" /> <DOI name="ClsPos" /> <DOI name="OpnPos" /> <DOI name="Mvm" /> <DOI name="Stuck" /> <DOI name="PosVlv" /> <DOI name="PosSpt" /> <DOI name="Pos" /> <DOI name="OpnLim" /> <DOI name="ClsLim" />
          </LN>
          <LN lnClass="DFCL" lnType="DFCL1_Typ" inst="1" prefix="">
            <DOI name="LifeEfcPct" /> <DOI name="MaintTms" /> <DOI name="EEHealth" /> <DOI name="WtrLev" /> <DOI name="OutH2Lev" /> <DOI name="Alim" /> <DOI name="Vlim" />
          </LN>
          <LN lnClass="DSTK" lnType="DSTK1_Typ" inst="1" prefix="">
            <DOI name="NamPlt" /> <DOI name="StcSt" /> <DOI name="CelVTrCnt" /> <DOI name="StcLodTms" /> <DOI name="MaintTms" /> <DOI name="Beh" /> <DOI name="Health" /> <DOI name="StcEfcPct" /> <DOI name="OutDCV" /> <DOI name="OutDCA" /> <DOI name="InClTmp" /> <DOI name="OutClTmp" /> <DOI name="InH2Pres" />
          </LN>
          <LN lnClass="SPRS" lnType="SPRS1_Typ" inst="1" prefix="">
            <DOI name="Alm" /> <DOI name="Trip" /> <DOI name="Beh" /> <DOI name="Health" /> <DOI name="AlmSet" />
          </LN>
          <LN lnClass="TPRS" lnType="TPRS1_Typ" inst="1" prefix="">
            <DOI name="EEName" /> <DOI name="EEHealth" /> <DOI name="Beh" /> <DOI name="Health" /> <DOI name="PresSv" />
          </LN>
          <LN lnClass="DFPM" lnType="DFPM1_Typ" inst="1" prefix="">
            <DOI name="FPMSt" /> <DOI name="CnvEfc" /> <DOI name="ProcTyp" />
          </LN>
          <LN lnClass="XSWI" lnType="XSWI1_Typ" inst="1" prefix="TNK">
            <DOI name="EEName" /> <DOI name="NamPlt" /> <DOI name="SwOpCap" /> <DOI name="Loc" /> <DOI name="LocKey" /> <DOI name="EEHealth" /> <DOI name="Blk" /> <DOI name="Beh" /> <DOI name="Health" /> <DOI name="LocSta" /> <DOI name="Pos" /> <DOI name="BlkOpn" /> <DOI name="BlkCls" /> <DOI name="Mod" /> <DOI name="BlkRef" />
          </LN>
          <LN lnClass="XSWI" lnType="XSWI1_Typ" inst="1" prefix="CEL">
            <DOI name="EEName" /> <DOI name="NamPlt" /> <DOI name="SwOpCap" /> <DOI name="Loc" /> <DOI name="LocKey" /> <DOI name="EEHealth" /> <DOI name="Blk" /> <DOI name="Beh" /> <DOI name="Health" /> <DOI name="LocSta" /> <DOI name="Pos" /> <DOI name="BlkOpn" /> <DOI name="BlkCls" /> <DOI name="Mod" /> <DOI name="BlkRef" />
          </LN>
        </LDevice>

        <LDevice inst="B1STG">
          <LN0 lnClass="LLN0" lnType="LLN01" inst="">
            <DOI name="Beh" /> <DOI name="Health" /> <DOI name="NamPlt" />
          </LN0>
          <LN lnClass="XSWI" lnType="XSWI1_Typ" inst="1" prefix="">
            <DOI name="SwTyp" /> <DOI name="Loc" /> <DOI name="OpCnt" /> <DOI name="Beh" /> <DOI name="Health" /> <DOI name="Pos" /> <DOI name="BlkOpn" /> <DOI name="BlkCls" /> <DOI name="NamPlt" />
          </LN>
          <LN lnClass="TTMP" lnType="TTMP1_Typ" inst="1" prefix="">
            <DOI name="NamPlt" /> <DOI name="Beh" /> <DOI name="Health" /> <DOI name="TmpSv" /> <DOI name="TmpTgt" />
          </LN>
          <LN lnClass="DBAT" lnType="DBAT1_Typ" inst="1" prefix="">
            <DOI name="EEName" /> <DOI name="ChaSt" /> <DOI name="DschSt" /> <DOI name="EEHealth" /> <DOI name="Amp" /> <DOI name="Watt" /> <DOI name="AvlChaAhr" /> <DOI name="AvlDschAhr" /> <DOI name="BatTyp" /> <DOI name="ChaAmpMax" /> <DOI name="AhrRtg" /> <DOI name="ChaVolMaxRtg" /> <DOI name="SocPro" />
          </LN>
          <LN lnClass="ZBAT" lnType="ZBAT1_Typ" inst="1" prefix="">
            <DOI name="BatHi" /> <DOI name="BatLo" /> <DOI name="Beh" /> <DOI name="Health" /> <DOI name="Vol" /> <DOI name="Amp" /> <DOI name="VolChgRte" />
          </LN>
        </LDevice>
      </Server>
    </AccessPoint>
  </IED>

  <DataTypeTemplates>
    <LNodeType id="LLN01" lnClass="LLN0"><DO name="Mod" type="ENC_Mod"/><DO name="Beh" type="ENS_Beh"/><DO name="Health" type="ENS_Health"/><DO name="NamPlt" type="LPL_NamPlt"/><DO name="Diag" type="SPS_Generic"/><DO name="LEDRs" type="SPS_Generic"/></LNodeType>
    <LNodeType id="LPHD1_Typ" lnClass="LPHD"><DO name="NamPlt" type="LPL_NamPlt"/><DO name="PhyNam" type="DPL_Generic"/><DO name="PhyHealth" type="ENS_Health"/><DO name="OutOv" type="SPS_Generic"/><DO name="Proxy" type="SPS_Generic"/><DO name="OpTmh" type="INS_Generic"/><DO name="Sim" type="SPS_Generic"/></LNodeType>
    
