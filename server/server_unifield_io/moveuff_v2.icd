    <LNodeType id="LTRK1_Typ" lnClass="LTRK"><DO name="Beh" type="ENS_Beh"/><DO name="Health" type="ENS_Health"/><DO name="GenTrk" type="TRK_Generic"/><DO name="UrcbTrk" type="TRK_Generic"/><DO name="BrcbTrk" type="TRK_Generic"/><DO name="GocbTrk" type="TRK_Generic"/></LNodeType>

    <LNodeType id="KTNK1_Typ" lnClass="KTNK"><DO name="NamPlt" type="LPL_NamPlt"/><DO name="EEHealth" type="ENS_Health"/><DO name="OpTmh" type="INS_Generic"/><DO name="Beh" type="ENS_Beh"/><DO name="Health" type="ENS_Health"/><DO name="LevPct" type="MV_Generic"/><DO name="Vlm" type="MV_Generic"/><DO name="VlmCap" type="ASG_Generic"/><DO name="TnkTyp" type="ENS_Generic"/></LNodeType>
    <LNodeType id="STMP1_Typ" lnClass="STMP"><DO name="Trip" type="SPS_Generic"/><DO name="RteTrip" type="SPS_Generic"/><DO name="Tmp" type="MV_Generic"/><DO name="TmpRte" type="MV_Generic"/><DO name="TripSet" type="ASG_Generic"/><DO name="RteTripSet" type="ASG_Generic"/></LNodeType>
