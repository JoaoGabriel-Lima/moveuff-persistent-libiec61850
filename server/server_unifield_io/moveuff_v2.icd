    <LNodeType id="SPRS1_Typ" lnClass="SPRS"><DO name="Alm" type="SPS_Generic"/><DO name="Trip" type="SPS_Generic"/><DO name="Beh" type="ENS_Beh"/><DO name="Health" type="ENS_Health"/><DO name="AlmSet" type="ASG_Generic"/></LNodeType>
    <LNodeType id="TPRS1_Typ" lnClass="TPRS"><DO name="EEName" type="DPL_Generic"/><DO name="EEHealth" type="ENS_Health"/><DO name="Beh" type="ENS_Beh"/><DO name="Health" type="ENS_Health"/><DO name="PresSv" type="MV_Generic"/></LNodeType>
    <LNodeType id="DFPM1_Typ" lnClass="DFPM"><DO name="FPMSt" type="ENS_Generic"/><DO name="CnvEfc" type="MV_Generic"/><DO name="ProcTyp" type="ENS_Generic"/></LNodeType>

    <LNodeType id="TTMP1_Typ" lnClass="TTMP"><DO name="NamPlt" type="LPL_NamPlt"/><DO name="Beh" type="ENS_Beh"/><DO name="Health" type="ENS_Health"/><DO name="TmpSv" type="MV_Generic"/><DO name="TmpTgt" type="ASG_Generic"/></LNodeType>
    <LNodeType id="DBAT1_Typ" lnClass="DBAT"><DO name="EEName" type="DPL_Generic"/><DO name="ChaSt" type="ENS_Generic"/><DO name="DschSt" type="ENS_Generic"/><DO name="EEHealth" type="ENS_Health"/><DO name="Amp" type="MV_Generic"/><DO name="Watt" type="MV_Generic"/><DO name="AvlChaAhr" type="MV_Generic"/><DO name="AvlDschAhr" type="MV_Generic"/><DO name="BatTyp" type="ENS_Generic"/><DO name="ChaAmpMax" type="ASG_Generic"/><DO name="AhrRtg" type="ASG_Generic"/><DO name="ChaVolMaxRtg" type="ASG_Generic"/><DO name="SocPro" type="MV_Generic"/></LNodeType>
    
